  /// Distinct from NOT_INTERESTED (a rep's decline). Reversible via the admin un-park action.
  PARKED
}

// Per-outlet MANDATE for which payout details the outlet must provide at KYC.
// BANK = must give bank account (name/number/IFSC + cheque); UPI = must give a UPI id;
// ANY = the rep chooses (among the tenant-allowed modes). Set/updated ONLY at the outlet
// master-upload (create or re-upload) — the KYC re-submission flow does NOT change it.
// Default BANK. UPI is only permissible when the tenant's salesApp.upiEnabled is ON — the
// outlet config can never enable UPI a tenant has disabled.
enum OutletPaymentType {
  BANK
