  updatedAt   DateTime @updatedAt

  outlets       Outlet[]
  clientConfigs OutletTypeClientConfig[]

  @@map("outlet_types")
}

model OutletTypeClientConfig {
  id           String @id @default(cuid())
  clientId     String
  outletTypeId String

  isEnabled          Boolean @default(true)
  displayName        String?
  loyaltyEnabled     Boolean @default(true)
  schemesEnabled     Boolean @default(true)
  visibilityEnabled  Boolean @default(true)
  payoutsEnabled     Boolean @default(true)
  leaderboardEnabled Boolean @default(true)
  targetsEnabled     Boolean @default(true)
  kycRequired        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outletType OutletType @relation(fields: [outletTypeId], references: [id])

  @@unique([clientId, outletTypeId], name: "clientId_outletTypeId")
  @@index([clientId])
  @@map("outlet_type_client_configs")
}

model Outlet {
  id                  String            @id @default(cuid())
  clientId            String // tenant slug — outlet carries its own tenant tag (may exist before its owner/partner)
  partnerId           String? // owner attached at KYC; outlet can be created (via upload) before its owner exists
  // Parent-child owner group link — the SINGLE authoritative grouping field, set by the admin
  // outlet-master upload (the "Parent ID" column). Points at a PARENT ChannelPartner (isParent=true).
  // Group membership of an outlet = its parentId; a group = all outlets sharing a parentId.
  // See docs/plans/PARTNER-MULTI-OUTLET.md.
  parentId            String?
  outletTypeId        String
  // ── Reference-only master-file columns (from the outlet upload) — used for report grouping/summary ──
  distributorCode     String?
  distributorName     String?
  beat                String?
  metro               String?
  zone                String?
  programName         String?
  programCategory     String?
  // Per-outlet payout-detail MANDATE (set/updated only at the outlet master-upload). Drives the
  // KYC form's paymentMode + required fields. Default BANK. UPI only if tenant upiEnabled is ON.
  requiredPaymentType OutletPaymentType @default(BANK)
  outletCode          String
  name                String
  ownerName           String?
  phone               String?
  addressLine1        String? // captured at KYC, not in the outlet master file
  addressLine2        String?
  city                String
  district            String?
  state               String
  pincode             String? // captured at KYC, not in the outlet master file
  country             String            @default("IN")
  latitude            Decimal?          @db.Decimal(10, 8)
  longitude           Decimal?          @db.Decimal(11, 8)
  isActive            Boolean           @default(true)
  isPrimary           Boolean           @default(false)
  // Outlet-level KYC intent — set when a sales agent marks the outlet as not interested.
  // When NOT_INTERESTED: outlet is also deactivated (isActive = false).
  kycIntent           OutletKycIntent?
  kycIntentBy         String? // userId of the sales agent who marked it
  kycIntentAt         DateTime? // when it was marked
  // Re-KYC flags: which KYC fields must be re-captured (ReKYCFlags shape — 20 booleans + remarks),
  // set via the Re-KYC flag upload. Read/written atomically per outlet; null = no re-KYC pending.
  reKycFlags          Json?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  deletedAt           DateTime?
  deactivatedAt       DateTime?
  reactivatedAt       DateTime?

  partner               ChannelPartner?        @relation("OutletOwner", fields: [partnerId], references: [id], onDelete: SetNull)
  // The parent owner of this outlet's group (isParent ChannelPartner), set by the admin upload.
  parent                ChannelPartner?        @relation("OutletParent", fields: [parentId], references: [id], onDelete: SetNull)
  outletType            OutletType             @relation(fields: [outletTypeId], references: [id])
  geoHistory            OutletGeoHistory[]
  salesAssignments      SalesUserAssignment[]
  // Visibility (POSM) photo-captures anchored to this outlet, one current row per window.
  visibilityCaptures    VisibilityCapture[]
  // Wave-0 scheme data-collection: roster rows that matched (linked to) this outlet.
  schemeRosterEntries   SchemeOutlet[]         @relation("SchemeRosterOutlet")

  @@unique([clientId, outletCode])
  @@index([clientId])
  @@index([partnerId])
  @@index([parentId])
  @@index([outletTypeId])
  @@index([distributorCode])
  @@index([pincode])
  @@index([state])
  @@index([isActive])
  @@index([deletedAt])
  @@map("outlets")
}

model OutletGeoHistory {
  id         String   @id @default(cuid())
  outletId   String
  latitude   Decimal  @db.Decimal(10, 8)
  longitude  Decimal  @db.Decimal(11, 8)
  capturedAt DateTime @default(now())
  deviceInfo String?
  accuracy   Decimal? @db.Decimal(8, 2)
  createdAt  DateTime @default(now())

  outlet Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@index([outletId])
  @@index([capturedAt])
  @@map("outlet_geo_history")
}

