// 194R gifts/payouts given OUTSIDE the platform — uploaded + added to the PAN's FY total.
model TdsOffPlatformEntry {
  id            String     @id @default(cuid())
  clientId      String
  section       TdsSection @default(SEC_194R)
  entryDate     DateTime
  panNumber     String
  outletCode    String?
  amountPaise   BigInt
  // FILE-LEVEL re-upload dedup. uploadBatchId is a DETERMINISTIC hash of the uploaded
  // file's rows (set by the service, not a random uuid). A DB-level PARTIAL unique index
  // on (clientId, section, panNumber, entryDate, amountPaise, COALESCE(outletCode,''),
  // uploadBatchId) WHERE uploadBatchId IS NOT NULL makes re-uploading the SAME file a
  // no-op while two DIFFERENT files each record their rows. Prisma can't model partial/
  // expression unique indexes → migration-only; the upload service catches P2002 and
  // reports the row as "skipped — duplicate entry". See 20260621000000_uat_hardening_constraints.
  uploadBatchId String?
  uploadedBy    String?
  createdAt     DateTime   @default(now())

  @@index([clientId, panNumber])
  @@index([clientId, entryDate])
  @@map("tds_off_platform_entries")
}

// TDS actually deposited to the government (reconciliation). 194R = CLIENT (clientId set,
// per-tenant); 194C = GIFSY (clientId null, platform). liability(computed) − deposited = outstanding.
model TdsDeposit {
  id            String           @id @default(cuid())
  section       TdsSection
  depositorType TdsDepositorType
  clientId      String?
  depositDate   DateTime
  panNumber     String
  outletCode    String?
  amountPaise   BigInt
  // FILE-LEVEL re-upload dedup (same model as TdsOffPlatformEntry): uploadBatchId is a
  // deterministic hash of the file's rows; DB-level PARTIAL unique on
  // (COALESCE(clientId,''), section, panNumber, depositDate, amountPaise,
  // COALESCE(outletCode,''), uploadBatchId) WHERE uploadBatchId IS NOT NULL. clientId is
  // nullable (194C = platform) so it is COALESCEd. Migration-only; service catches P2002.
  uploadBatchId String?
  uploadedBy    String?
  createdAt     DateTime         @default(now())

  @@index([section, panNumber])
  @@index([clientId, section, panNumber])
  @@index([depositDate])
  @@map("tds_deposits")
}

/// DEDUCT-method carry-forward ledger (append-only). Running carry-forward for a payee =
/// the latest row's carryForwardPaise per (panNumber, section, fyLabel). One row per payout
/// event where the deduct engine runs. Reproducible frozen record of what was withheld.
model TdsDeductionEntry {
  id                    String     @id @default(cuid())
  clientId              String
  panNumber             String
  section               TdsSection
  fyLabel               String
  creditPayoutEntryId   String?
  outletCode            String?
  eventBasePaise        BigInt // the payout base at this event
  cumulativeBasePaise   BigInt // PAN FY cumulative base after this event
  tdsRate               Decimal    @db.Decimal(5, 2)
  tdsDueCumulativePaise BigInt // TDS due on the cumulative base
  tdsDeductedPriorPaise BigInt // sum deducted before this event
  tdsDeductedThisPaise  BigInt // deducted from THIS payout
  carryForwardPaise     BigInt // remaining un-deducted after this event
  createdAt             DateTime   @default(now())

  @@index([panNumber, section, fyLabel])
  @@index([clientId])
  @@index([creditPayoutEntryId])
  @@map("tds_deduction_entries")
}

/// GROSS-UP pro-rata tenant recovery / attribution ledger ("in lieu of TDS deduction"),
/// append-only. Dashboard/report only — NEVER surfaced on the invoice face. Splits the TDS
/// deposited for a PAN across its contributing tenants by base share.
model TdsRecoveryEntry {
  id               String     @id @default(cuid())
  clientId         String // tenant recovered from
  panNumber        String
  section          TdsSection
  fyLabel          String
  tdsInvoiceId     String? // the AutoInvoice(kind=TDS) this recovery settles
  panTdsTotalPaise BigInt // total TDS deposited for the PAN at this event
  tenantBasePaise  BigInt // this tenant's contribution (pro-rata numerator)
  panBasePaise     BigInt // PAN aggregate base (denominator)
  tenantSharePaise BigInt // pro-rata recovery amount
  createdAt        DateTime   @default(now())

  @@index([clientId, fyLabel])
  @@index([panNumber, section, fyLabel])
  @@index([tdsInvoiceId])
  @@map("tds_recovery_entries")
}

model AutoInvoice {
  id                  String            @id @default(cuid())
  clientId            String
  invoiceNumber       String            @unique
  partnerId           String
  outletCode          String
  period              String // "YYYY-MM"
  invoiceDate         DateTime
  periodStartDate     DateTime?
  periodEndDate       DateTime?
  status              AutoInvoiceStatus @default(GENERATED)
  invoiceKind         AutoInvoiceKind   @default(SERVICE) // SERVICE = visibility service invoice; TDS = gross-up TDS invoice
  invoiceNumberEdited Boolean           @default(false)
  lineItems           Json
  subtotalPaise       BigInt
  gstPaise            BigInt            @default(0)
  gstType             String? // CGST_SGST | IGST | null (unregistered)
  totalPaise          BigInt
  // Frozen retailer/KYC/GST/bank details at generation time (required — an invoice
  // without its snapshot is unrecoverable if source data later changes).
  snapshot            Json              @default("{}")
  pdfUrl              String?
  emailSentAt         DateTime?
  // Lock at UTR entry (set when the linked payout's UTR/date is recorded) — decoupled
  // from the manual PAID status. Edits (invoice-number) gate on lockedAt != null.
  lockedAt            DateTime?
  // TDS invoices (invoiceKind=TDS): the retailer PAN + FY they settle (one per client/PAN/FY).
  linkedPanNumber     String?
  linkedFyLabel       String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  creditEntries CreditPayoutEntry[]
  reimbursement GstReimbursement?

  @@unique([clientId, outletCode, period, invoiceKind]) // one SERVICE invoice per outlet/month; a TDS row can coexist
  @@index([clientId])
  @@index([partnerId])
  @@index([invoiceDate])
  @@index([linkedPanNumber])
  @@map("auto_invoices")
}

enum AutoInvoiceStatus {
  GENERATED // editable (incl. invoice number); not yet paid
  PAID // locked — invoice number can no longer change
}

enum AutoInvoiceKind {
  SERVICE // the visibility marketing-and-support service invoice
  TDS // the gross-up "TDS invoice" (body = TDS deposited against the retailer PAN)
}

/// GST HOLDBACK: the SERVICE invoice's base is paid to the retailer immediately, but the GST
/// is held back and released only on the retailer's proof of GST deposit, via a Gifsy-admin-only
/// GST-reimbursement screen. One per GST-bearing SERVICE invoice.
model GstReimbursement {
  id               String                 @id @default(cuid())
  clientId         String
  autoInvoiceId    String                 @unique
  partnerId        String
  outletCode       String
  gstPaise         BigInt
  status           GstReimbursementStatus @default(HELD)
  proofUrl         String?
  releasePayoutRef String?
  releasedAt       DateTime?
  releasedById     String?
  notes            String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  autoInvoice AutoInvoice @relation(fields: [autoInvoiceId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([status])
  @@map("gst_reimbursements")
}

enum GstReimbursementStatus {
  HELD // GST withheld pending the retailer's deposit proof
  RELEASED // reimbursed to the retailer after proof
}

