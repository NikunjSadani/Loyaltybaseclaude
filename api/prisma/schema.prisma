model SalesUser {
  id               String    @id @default(cuid())
  clientId         String // tenant slug — employeeCode is unique per tenant (RF7)
  userId           String    @unique
  hierarchyLevelId String
  employeeCode     String
  reportingToId    String?
  region           String?
  zone             String?
  isActive         Boolean   @default(true)
  joinedAt         DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  hierarchyLevel   SalesHierarchyLevel   @relation(fields: [hierarchyLevelId], references: [id])
  reportingTo      SalesUser?            @relation("SalesUserReporting", fields: [reportingToId], references: [id])
  subordinates     SalesUser[]           @relation("SalesUserReporting")
  assignments      SalesUserAssignment[]
  // Wave-0 scheme data-collection: roster rows tagging this employee (Mode B Excel).
  schemeRosterTags SchemeOutlet[]        @relation("SchemeRosterSalesUser")
  // Visibility (POSM) captures/submissions performed by this sales rep (D8).
  visibilityCaptures    VisibilityCapture[]           @relation("VisibilityCaptureSubmitter")
  visibilityCaptureSubs VisibilityCaptureSubmission[] @relation("VisibilityCaptureSubmissionSubmitter")

  @@unique([clientId, employeeCode])
  @@index([clientId])
  @@index([userId])
  @@index([hierarchyLevelId])
  @@index([reportingToId])
  @@index([employeeCode])
  @@index([deletedAt])
  @@map("sales_users")
}

model SalesUserAssignment {
  id           String    @id @default(cuid())
  salesUserId  String
  partnerId    String?
  outletId     String?
  assignedAt   DateTime  @default(now())
  unassignedAt DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  salesUser SalesUser       @relation(fields: [salesUserId], references: [id], onDelete: Cascade)
  partner   ChannelPartner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  outlet    Outlet?         @relation(fields: [outletId], references: [id], onDelete: SetNull)

  @@index([salesUserId])
  @@index([partnerId])
  @@index([outletId])
  @@map("sales_user_assignments")
}

// ============================================================
// MODULE 3: CHANNEL PARTNERS
// ============================================================

model ChannelPartner {
  id                  String               @id @default(cuid())
  clientId            String // denormalised for efficient tenant filtering
  // Nullable: a PARENT owner (isParent=true) may exist with no login. @unique still holds —
  // Postgres treats multiple NULLs as distinct, so many login-less parents are fine.
  userId              String?              @unique
  partnerCode         String
  businessName        String
  ownerName           String
  // Nullable for the same reason — a bare parent may have no phone/login.
  phone               String?
  email               String?
  gstNumber           String?
  panNumber           String?
  // ── Entity / GST registration type (set at KYC approval; feeds P6 invoicing/TDS) ──
  entityType          EntityType?
  gstRegistrationType GstRegistrationType?
  // ── Bank / payout details (set on KYC approval) ──────────────────────────────
  bankName            String?
  bankAccountNumber   String?
  bankAccountHolder   String?
  ifscCode            String?
  upiId               String?
  paymentMode         String? // 'bank' | 'upi'
  totalEarnedPoints   Int                  @default(0)
  referredBy          String?
  isActive            Boolean              @default(true)
  // Parent-child owner groups (see docs/plans/PARTNER-MULTI-OUTLET.md). A PARENT is a
  // non-operating owner: no outlet of its own, no spendable wallet; groups child outlets
  // (via Outlet.parentId) + provides the consolidated read-only view. Excluded from all
  // partner-facing lists/KPIs by an `isParent:false` filter.
  isParent            Boolean              @default(false)
  // DERIVED group key (see docs/plans/PARTNER-MULTI-OUTLET.md §"uniqueness engine"). Mirrors
  // this owner's outlet `parentId` (the single source of truth). Written by KYC-create and
  // kept in lockstep by a DB trigger on `outlets` — never edited independently. Hosts the
  // PARTIAL UNIQUE indexes on (clientId,gstNumber)/(clientId,panNumber) WHERE groupId IS NULL:
  // a hard, race-proof DB rule for UNGROUPED owners, while grouped siblings (groupId set) are
  // excepted so they may share GST/PAN. Cross-group is app-enforced (checkGroupUniqueness + lock).
  groupId             String?
  accountId           String?              @unique // Employee Rewards Phase 1 — this outlet's RewardAccount (additive)
  onboardedAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?

  user                  User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  outlets               Outlet[]               @relation("OutletOwner")
  // Outlets that name THIS partner as their parent (child outlets of a parent group).
  childOutlets          Outlet[]               @relation("OutletParent")
  kycSubmissions        KycSubmission[]
  wallets               Wallet[]
  account               RewardAccount?         @relation(fields: [accountId], references: [id], onDelete: SetNull)
  salesAssignments      SalesUserAssignment[]
  redemptionOrders      RedemptionOrder[]
  payoutTransactions    PayoutTransaction[]
  leaderboardEntries    LeaderboardEntry[]
  // Wave-0 scheme data-collection: roster rows whose matched (linked) owner is this partner.
  schemeRosterEntries   SchemeOutlet[]         @relation("SchemeRosterPartner")

  @@unique([clientId, partnerCode])
  // NOTE: the old `@@unique([clientId, gstNumber])` is REPLACED by a PARTIAL unique index
  // `WHERE groupId IS NULL` (grouped siblings may share GST) — defined in the migration, not
  // here (Prisma can't express partial indexes). A matching partial unique exists for panNumber.
  // Cross-group uniqueness is app-enforced (checkGroupUniqueness) with an advisory lock.
  @@index([clientId])
  @@index([userId])
  @@index([partnerCode])
  @@index([gstNumber])
  @@index([groupId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("channel_partners")
}

