// ============================================================
// MODULE: CREDITS & PAYOUTS (DB-backed)
// ============================================================

enum CreditBatchStatus {
  PENDING_CONFIRM
  CONFIRMED
  PARTIALLY_REVERSED
}

enum CreditAwardType {
  POINTS
  PAYOUT
}

enum CreditReversalStatus {
  PENDING_GIFSY
  APPROVED
  PARTIAL
  REJECTED
}

enum CreditEntryStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  // REVERSED = clawed back via an approved CreditReversal — terminally removed from
  // payability. Distinct from FAILED (a bank-rejected disbursement, which GLM-2 RE-banks);
  // keeping them separate prevents a reversed award from being resurrected into a download.
  REVERSED
}

/// Classifies a credit field's payout stream. VISIBILITY = 194C-eligible marketing/support
/// services (self-billed invoice + TDS engine); INCENTIVE = 194R-style benefit/other.
/// Replaces the overloaded isSeparatePayout boolean (kept as a deprecated mirror until W3).
enum PayoutStream {
  VISIBILITY
  INCENTIVE
}

model CreditField {
  id               String       @id @default(cuid())
  clientId         String
  name             String
  isActive         Boolean      @default(true)
  isSeparatePayout Boolean      @default(false) // DEPRECATED mirror of payoutStream=VISIBILITY — dropped in W3
  payoutStream     PayoutStream @default(INCENTIVE)
  outletTypeAwards Json
  order            Int
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([clientId, name])
  @@index([clientId])
  @@index([isActive])
  @@map("credit_fields")
}

model CreditBatch {
  id               String            @id @default(cuid())
  clientId         String
  // batchCode is per-tenant-sequential (CB-<period>-NNN via a per-clientId count) → unique PER
  // TENANT, not globally. A global @unique collides the moment a 2nd tenant reuses the same code.
  batchCode        String
  period           String
  status           CreditBatchStatus @default(PENDING_CONFIRM)
  uploadedBy       String
  uploadedAt       DateTime          @default(now())
  confirmedAt      DateTime?
  confirmedBy      String?
  totalOutlets     Int               @default(0)
  totalPoints      Int               @default(0)
  totalPayoutPaise BigInt            @default(0)
  rows             Json              @default("[]")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  payoutEntries CreditPayoutEntry[]
  reversals     CreditReversal[]

  @@index([clientId])
  @@unique([clientId, batchCode], name: "clientId_batchCode")
  @@index([period])
  @@index([status])
  @@map("credit_batches")
}

model CreditPayoutEntry {
  id             String            @id @default(cuid())
  clientId       String
  batchId        String
  downloadId     String?
  outletId       String
  outletName     String
  fieldId        String
  fieldName      String
  period         String
  amountPaise    BigInt
  narration      String            @default("")
  status         CreditEntryStatus @default(PENDING)
  utr            String?
  paidAt         DateTime?
  // Visibility-payout linkage + FROZEN TDS treatment (stamped by value at confirm — never a
  // live config re-lookup). tdsSection/tdsMethodology null = legacy / not-applicable.
  autoInvoiceId    String?
  tdsSection       TdsSection?
  tdsMethodology   TdsMethodology?
  tdsDeductedPaise BigInt          @default(0) // DEDUCT-method net withheld at download; 0 for gross-up/incentive
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  batch       CreditBatch           @relation(fields: [batchId], references: [id])
  download    CreditPayoutDownload? @relation(fields: [downloadId], references: [id])
  autoInvoice AutoInvoice?          @relation(fields: [autoInvoiceId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([batchId])
  @@index([outletId])
  @@index([period])
  @@index([status])
  @@index([autoInvoiceId])
  @@map("credit_payout_entries")
}

model CreditPayoutDownload {
  id               String   @id @default(cuid())
  clientId         String
  // downloadCode is per-tenant-sequential (PD-<period>-NNN) → unique PER TENANT, not globally.
  downloadCode     String
  period           String
  groupType        String
  fieldId          String?
  fieldName        String?
  status           String   @default("OPEN")
  downloadedBy     String
  downloadedAt     DateTime @default(now())
  totalAmountPaise BigInt
  bankSnapshots    Json     @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  entries CreditPayoutEntry[]

  @@unique([clientId, downloadCode], name: "clientId_downloadCode")
  @@index([clientId])
  @@index([period])
  @@index([status])
  @@map("credit_payout_downloads")
}

model CreditReversal {
  id             String               @id @default(cuid())
  clientId       String
  batchId        String
  outletId       String
  outletName     String
  fieldId        String
  fieldName      String
  period         String
  awardType      CreditAwardType
  originalPaise  BigInt
  requestedPaise BigInt
  approvedPaise  BigInt?
  // Reporting only: PENDING points an approved POINTS reversal could NOT claw back
  // (partner already redeemed them). reversed = approvedPaise - shortfallPaise.
  // The client settles `pending` off-platform; the platform does nothing with it.
  shortfallPaise BigInt               @default(0)
  requestedBy    String
  requestedAt    DateTime             @default(now())
  approvedBy     String?
  approvedAt     DateTime?
  status         CreditReversalStatus @default(PENDING_GIFSY)
  remarks        String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  batch CreditBatch @relation(fields: [batchId], references: [id])

  @@index([clientId])
  @@index([batchId])
  @@index([outletId])
  @@index([status])
  @@map("credit_reversals")
}
