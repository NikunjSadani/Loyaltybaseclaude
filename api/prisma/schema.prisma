// Wave-0 scheme data-collection: the CURRENT enrollment/submission for one roster row.
// The enrollment SUBJECT is now the roster row (SchemeOutlet), NOT a ChannelPartner —
// superseding the 20260723140000 partner re-key. A roster row may be a matched (linked)
// outlet or a standalone id+name data point (D4/D9). One CURRENT submission per roster
// row per scheme (schemeOutletId is globally @unique → a 1:1 anchor); full history lives in
// SchemeSubmission. See docs/plans/SCHEME-DATA-COLLECTION-DESIGN.md §11.
model SchemeEnrollment {
  id                String                 @id @default(cuid())
  schemeId          String
  schemeOutletId    String                 @unique
  status            SchemeEnrollmentStatus @default(SUBMITTED)
  enrollmentMode    String                 @default("SELF")
  // Latest submission snapshot (media/geo live INSIDE per field — §11 "Media & geo").
  formValues        Json?
  // Version of THIS current submission (bumped on each resubmit after a rejection, D10).
  currentVersion    Int                    @default(1)
  // The SchemeEnrollmentForm version this submission was captured against (D11).
  formVersion       Int
  // Reason the admin last rejected (D10); null unless status = REJECTED.
  rejectionReason   String?
  // The login that PERFORMED the enrollment, for AUDIT only. Nullable: null when a
  // login-less sibling self-enrolls via the picker, or a standalone rep-filled row.
  // Optional + SetNull so deleting the login keeps the captured data intact.
  submittedByUserId String?
  enrolledAt        DateTime               @default(now())
  // Soft-delete (admin "delete a filled enrollment"): hidden from every list/report/read.
  // The 1:1 on schemeOutletId is kept — re-enrolling the outlet RESETS this same row
  // (clears deletedAt + appends a new version), so the row is freed to re-enroll while the
  // submission history is retained and the delete stays recoverable. Null = live.
  deletedAt         DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  scheme       Scheme             @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  schemeOutlet SchemeOutlet       @relation(fields: [schemeOutletId], references: [id], onDelete: Cascade)
  submittedBy  User?              @relation("SchemeEnrollmentSubmitter", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  submissions  SchemeSubmission[]

  @@index([schemeId])
  @@index([submittedByUserId])
  @@index([status])
  @@index([deletedAt])
  @@map("scheme_enrollments")
}

// Wave-0 scheme data-collection: the roster / enrollment subject (D3/D4). Each row is one
// enrollable subject for one scheme — either a matched (linked) tenant outlet or a
// standalone id+name data point (no app access, no KYC). Created by an Excel upload
// (Mode B), a Mode-A frozen snapshot, or lazily on first enroll (Mode-A live-rule).
// See docs/plans/SCHEME-DATA-COLLECTION-DESIGN.md §11.
model SchemeOutlet {
  id                String   @id @default(cuid())
  clientId          String
  schemeId          String
  // The supplied outlet id (may or may not match a tenant outlet) + its display name.
  outletRef         String
  outletName        String
  // Set when outletRef matches a tenant outlet/owner (linked); null = standalone data point.
  matchedOutletId   String?
  matchedPartnerId  String?
  // Tagged employee from the Excel (Mode B); null in filter mode (reach falls back to the
  // outlet's global sales assignment + up-hierarchy).
  taggedSalesUserId String?
  // Per-outlet prefill variable values from the Excel (Mode B).
  prefillValues     Json?
  // Soft-delete (roster-row remove/restore, GIFSY-admin only) — the SINGLE source of
  // truth for a removed roster row. Set → the row (and any enrollment reached through
  // it) is hidden from every read; cleared → fully restored. Non-destructive.
  deletedAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  scheme          Scheme             @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  matchedOutlet   Outlet?            @relation("SchemeRosterOutlet", fields: [matchedOutletId], references: [id], onDelete: SetNull)
  matchedPartner  ChannelPartner?    @relation("SchemeRosterPartner", fields: [matchedPartnerId], references: [id], onDelete: SetNull)
  taggedSalesUser SalesUser?         @relation("SchemeRosterSalesUser", fields: [taggedSalesUserId], references: [id], onDelete: SetNull)
  enrollment      SchemeEnrollment?
  submissions     SchemeSubmission[]

  @@unique([schemeId, outletRef])
  @@index([schemeId])
  @@index([schemeId, deletedAt])
  @@index([matchedOutletId])
  @@index([matchedPartnerId])
  @@index([taggedSalesUserId])
  @@index([clientId])
  @@map("scheme_outlets")
}

// Wave-0 scheme data-collection: append-only, IMMUTABLE submission history (D10/D11).
// Every submit/resubmit appends a frozen snapshot; prior versions are always retained.
// See docs/plans/SCHEME-DATA-COLLECTION-DESIGN.md §11.
model SchemeSubmission {
  id                String                 @id @default(cuid())
  schemeId          String
  schemeOutletId    String
  enrollmentId      String
  version           Int
  status            SchemeEnrollmentStatus
  // Frozen snapshot of the captured values (media/geo live inside per field).
  formValues        Json
  formVersion       Int
  enrollmentMode    String
  submittedByUserId String?
  rejectionReason   String?
  createdAt         DateTime               @default(now())

  scheme       Scheme           @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  schemeOutlet SchemeOutlet     @relation(fields: [schemeOutletId], references: [id], onDelete: Cascade)
  enrollment   SchemeEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  submittedBy  User?            @relation("SchemeSubmissionSubmitter", fields: [submittedByUserId], references: [id], onDelete: SetNull)

  @@unique([enrollmentId, version])
  @@index([schemeId])
  @@index([schemeOutletId])
  @@index([enrollmentId])
  @@map("scheme_submissions")
}

// Configurable enrollment form (P4.2) — 1:1 with a Scheme. The rich form schema
// (field defs incl. CALCULATED + visibleWhen, ported from lib/campaign.ts) is
// stored as JSON; submission values land on SchemeEnrollment.formValues.
// campaignType = enrollment audience (LOYALTY_ONLY / OPEN_CAMPAIGN / MIXED).
model SchemeEnrollmentForm {
  id           String   @id @default(cuid())
  schemeId     String   @unique
  campaignType String   @default("LOYALTY_ONLY")
  formSchema   Json
  // Current form version (D11). Bumped on each post-launch edit; every append-only snapshot
  // is kept in SchemeEnrollmentFormVersion so old submissions render coherently.
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  scheme Scheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)

  @@map("scheme_enrollment_forms")
}

// Wave-0 scheme data-collection: append-only form snapshots (D11), so a submission captured
// against an earlier form version still renders coherently after the form is edited.
// See docs/plans/SCHEME-DATA-COLLECTION-DESIGN.md §11.
model SchemeEnrollmentFormVersion {
  id           String   @id @default(cuid())
  schemeId     String
  version      Int
  campaignType String
  formSchema   Json
  createdAt    DateTime @default(now())

  scheme Scheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)

  @@unique([schemeId, version])
  @@index([schemeId])
  @@map("scheme_enrollment_form_versions")
}

// Wave-0 scheme data-collection: notification broadcast send-log (D29). The Gifsy admin can
// trigger MSG91 WhatsApp/SMS sends multiple times during a scheme's life; each send is logged.
// See docs/plans/SCHEME-DATA-COLLECTION-DESIGN.md §11.
model SchemeBroadcast {
  id              String   @id @default(cuid())
  clientId        String
  schemeId        String
  channel         String
  templateId      String
  // OUTLETS | SALES | BOTH — who the message targeted.
  recipientScope  String
  // Optional filter narrowing the recipient set (type/program/zone/state/…).
  recipientFilter Json?
  sentCount       Int
  failedCount     Int      @default(0)
  sentByUserId    String?
  createdAt       DateTime @default(now())

  scheme Scheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  sentBy User?  @relation("SchemeBroadcastSender", fields: [sentByUserId], references: [id], onDelete: SetNull)

  @@index([schemeId])
  @@index([clientId])
  @@map("scheme_broadcasts")
}

model LoginLog {
  id         String   @id @default(cuid())
  userId     String
  ipAddress  String?
  deviceInfo String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("login_logs")
}

