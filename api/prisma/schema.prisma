  clientId   String
  version    Int
  formSchema Json
  createdAt  DateTime @default(now())

  @@unique([clientId, version])
  @@index([clientId])
  @@map("visibility_form_versions")
}

// Current visibility capture per (outlet, window). A window is satisfied only by an APPROVED
// capture (D7); reject re-opens it (D11). One current row per (clientId, outletId, windowKey);
// full version history lives in VisibilityCaptureSubmission. See docs/plans/VISIBILITY-POSM-DESIGN.md.
model VisibilityCapture {
  id                     String                  @id @default(cuid())
  clientId               String
  outletId               String
  // Denormalised for report/queue display + stable if the outlet code later changes.
  outletCode             String
  outletName             String
  // Frequency window key: YYYY-MM-Pn, computed once at capture time in IST (D6).
  windowKey              String
  status                 VisibilityCaptureStatus @default(SUBMITTED)
  // Current submission snapshot (photo keys + geo + fields live inside per field).
  formValues             Json?
  currentVersion         Int                     @default(1)
  // The VisibilityForm version this capture was taken against (D11).
  formVersion            Int
  // Capture geo + accuracy (device GPS at submit) + server-computed geo-fence result (D10).
  captureLat             Decimal?                @db.Decimal(10, 8)
  captureLng             Decimal?                @db.Decimal(11, 8)
  captureAccuracy        Decimal?                @db.Decimal(8, 2)
  // Distance (m) from the outlet's KYC board-photo reference geo; null if no reference geo.
  distanceMeters         Decimal?                @db.Decimal(10, 2)
  // true = within tenant radius; false = outside (blocked at submit unless fence off);
  // null = reference geo unavailable → ALLOWED but FLAGGED (D10).
  geoFenceOk             Boolean?
  // Client-reported capture instant vs server receive instant — large skew is flagged.
  capturedAt             DateTime?
  receivedAt             DateTime                @default(now())
  // The capturing sales rep (D8 — visibility is sales-captured only).
  submittedBySalesUserId String?
  // The Gifsy admin who last approved/rejected.
  approvedByUserId       String?
  reviewedAt             DateTime?
  rejectionReason        String?
  // Controlled rejection reason code (free text stays in rejectionReason).
  rejectionReasonCode    String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  outlet      Outlet                        @relation(fields: [outletId], references: [id], onDelete: Cascade)
  submittedBy SalesUser?                    @relation("VisibilityCaptureSubmitter", fields: [submittedBySalesUserId], references: [id], onDelete: SetNull)
  approvedBy  User?                         @relation("VisibilityCaptureApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  submissions VisibilityCaptureSubmission[]
  imageHashes VisibilityImageHash[]

  @@unique([clientId, outletId, windowKey])
  @@index([clientId, windowKey])
  @@index([clientId, status])
  @@index([outletId])
  @@index([submittedBySalesUserId])
  @@map("visibility_captures")
}

// Append-only, immutable capture history (D11): every submit/resubmit appends a frozen snapshot.
model VisibilityCaptureSubmission {
  id                     String                  @id @default(cuid())
  clientId               String
  captureId              String
  outletId               String
  windowKey              String
  version                Int
  status                 VisibilityCaptureStatus
  formValues             Json
  formVersion            Int
  captureLat             Decimal?                @db.Decimal(10, 8)
  captureLng             Decimal?                @db.Decimal(11, 8)
  captureAccuracy        Decimal?                @db.Decimal(8, 2)
  distanceMeters         Decimal?                @db.Decimal(10, 2)
  geoFenceOk             Boolean?
  submittedBySalesUserId String?
  rejectionReason        String?
  rejectionReasonCode    String?
  createdAt              DateTime                @default(now())

  capture     VisibilityCapture @relation(fields: [captureId], references: [id], onDelete: Cascade)
  submittedBy SalesUser?        @relation("VisibilityCaptureSubmissionSubmitter", fields: [submittedBySalesUserId], references: [id], onDelete: SetNull)

  @@unique([captureId, version])
  @@index([clientId, windowKey])
  @@index([captureId])
  @@map("visibility_capture_submissions")
}

// Per-image content hash for duplicate-photo detection: flag when the same photo reappears
// across outlets/windows within a tenant (flag-not-block; surfaced in the Gifsy queue).
model VisibilityImageHash {
  id        String   @id @default(cuid())
  clientId  String
  captureId String
  hash      String
  createdAt DateTime @default(now())

  capture VisibilityCapture @relation(fields: [captureId], references: [id], onDelete: Cascade)

  @@index([clientId, hash])
  @@index([captureId])
  @@map("visibility_image_hashes")
}

