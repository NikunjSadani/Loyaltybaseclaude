  stateCode         String?
  cityCode          String?
  pincodePattern    String?
  isExclusion       Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  scheme Scheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)

  @@index([schemeId])
  @@index([specificPartnerId])
  @@map("scheme_eligibility")
}

// ============================================================
// MODULE 9: WALLET & POINTS
// ============================================================

/// Employee Rewards Phase 1 — the unified reward-holder the wallet attaches to.
/// ONE model for every earner: accountType OUTLET (profile = ChannelPartner) or
/// EMPLOYEE (profile = SalesUser, wired in Phase 2). The points engine (Wallet /
/// WalletTransaction / PointsLedger / redemption) operates on the account/wallet and
/// is earner-agnostic. ADDITIVE: outlets keep ChannelPartner + Wallet.partnerId as
/// the profile; the account is layered on as the owner (no compliance-code churn).
model RewardAccount {
  id          String      @id @default(cuid())
  clientId    String
  accountType AccountType
  status      String      @default("ACTIVE")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  wallet        Wallet?
  orders        RedemptionOrder[]
  outletProfile ChannelPartner?

  @@index([clientId])
  @@map("reward_accounts")
}

enum AccountType {
  OUTLET
  EMPLOYEE
}

model Wallet {
  id                String    @id @default(cuid())
  partnerId         String    @unique
  accountId         String?   @unique // Employee Rewards Phase 1 — unified owner (additive; partnerId kept as the outlet profile)
  earnedPoints      Int       @default(0)
  lockedPoints      Int       @default(0)
  redeemablePoints  Int       @default(0)
  redeemedPoints    Int       @default(0)
  expiredPoints     Int       @default(0)
  lifetimeEarned    Int       @default(0)
  lifetimeRedeemed  Int       @default(0)
  lifetimeExpired   Int       @default(0)
  lastTransactionAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  partner      ChannelPartner      @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  // Restrict (not SetNull): a funded wallet's account must never be deletable out from under
  // it (Phase-2 employee wallets are account-only-owned → SetNull would strand money).
  account      RewardAccount?      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  transactions WalletTransaction[]
  pointsLedger PointsLedger[]

  @@index([partnerId])
  @@map("wallets")
}

model WalletTransaction {
  id              String                @id @default(cuid())
  walletId        String
  transactionType WalletTransactionType
  points          Int
  balanceBefore   Int
  balanceAfter    Int
  balanceType     String
  referenceType   String?
  referenceId     String?
  description     String?
  metadata        Json?
  createdAt       DateTime              @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([transactionType])
  @@index([referenceType, referenceId])
  @@index([createdAt])
  @@map("wallet_transactions")
}

model PointsLedger {
  id              String           @id @default(cuid())
  walletId        String
  schemeId        String?
  transactionType PointsLedgerType
  points          Int
  lockedUntil     DateTime?
  expiresAt       DateTime?
  isExpired       Boolean          @default(false)
  isClaimed       Boolean          @default(false)
  claimedAt       DateTime?
  sourceType      String?
  sourceId        String?
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  wallet Wallet  @relation(fields: [walletId], references: [id], onDelete: Cascade)
  scheme Scheme? @relation(fields: [schemeId], references: [id], onDelete: SetNull)

  @@index([walletId])
  @@index([schemeId])
  @@index([lockedUntil])
  @@index([expiresAt])
  @@index([isExpired])
  @@index([createdAt])
  @@map("points_ledger")
}

model PointExpiryConfig {
  id                String   @id @default(cuid())
  clientId          String
  schemeId          String?
  expiryDays        Int
  warningDaysBefore Int      @default(7)
  isDefault         Boolean  @default(false)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([clientId])
  @@index([schemeId])
  @@map("point_expiry_config")
}

