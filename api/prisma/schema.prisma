  updatedAt   DateTime @updatedAt

  parent   RewardCategory?  @relation("RewardCategoryHierarchy", fields: [parentId], references: [id])
  children RewardCategory[] @relation("RewardCategoryHierarchy")
  rewards  RewardCatalog[]

  @@index([clientId])
  @@index([parentId])
  @@map("reward_categories")
}

model RewardCatalog {
  id                  String              @id @default(cuid())
  clientId            String
  categoryId          String
  code                String
  name                String
  description         String?
  imageUrls           Json?
  pointsCost          Int
  mrpPaise            Int?
  redemptionMode      PayoutMode
  status              RewardCatalogStatus @default(ACTIVE)
  minRedemptionPoints Int?
  maxRedemptionPoints Int?
  stockQuantity       Int?
  termsAndConditions  String?
  metadata            Json?
  sortOrder           Int                 @default(0)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  deletedAt           DateTime?

  category RewardCategory    @relation(fields: [categoryId], references: [id])
  orders   RedemptionOrder[]

  @@index([clientId])
  @@index([categoryId])
  @@index([status])
  @@index([redemptionMode])
  @@index([deletedAt])
  @@map("reward_catalog")
}

model RedemptionOrder {
  id                   String           @id @default(cuid())
  partnerId            String
  accountId            String?          // Employee Rewards Phase 1 — unified owner (additive; partnerId kept)
  rewardId             String
  orderNumber          String           @unique
  status               RedemptionStatus @default(PENDING)
  pointsDeducted       Int
  quantity             Int              @default(1)
  totalPointsCost      Int
  // INR value of the benefit (paise), frozen at redemption from the points↔₹ converter
  // (pointsDeducted ÷ conversionRate). Used as the 194R TDS base. See P6.5-TDS-SPEC.
  valuePaise           BigInt?
  // Points↔₹ conversion rate ×100 (centi-rate), SNAPSHOT at redeem time so the
  // confirm-time valuePaise/TDS math is deterministic even if a tenant later edits
  // the per-tenant rate. Nullable: pre-migration orders fall back to the live rate.
  conversionRateCenti  Int?
  redemptionMode       PayoutMode
  deliveryName         String?
  deliveryPhone        String?
  deliveryAddressLine1 String?
  deliveryAddressLine2 String?
  deliveryCity         String?
  deliveryState        String?
  deliveryPincode      String?
  trackingNumber       String?
  trackingUrl          String?
  voucherCode          String?
  voucherProvider      String?
  dispatchedAt         DateTime?
  deliveredAt          DateTime?
  cancelledAt          DateTime?
  cancelReason         String?
  notes                String?
  metadata             Json?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  partner       ChannelPartner            @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  account       RewardAccount?            @relation(fields: [accountId], references: [id], onDelete: Restrict)
  reward        RewardCatalog             @relation(fields: [rewardId], references: [id])
  statusHistory RedemptionStatusHistory[]

  @@index([partnerId])
  @@index([accountId])
  @@index([rewardId])
  @@index([status])
  @@index([orderNumber])
  @@index([createdAt])
  @@map("redemption_orders")
}

model RedemptionStatusHistory {
  id          String            @id @default(cuid())
  orderId     String
  fromStatus  RedemptionStatus?
  toStatus    RedemptionStatus
  changedById String?
  notes       String?
  metadata    Json?
  createdAt   DateTime          @default(now())

  order RedemptionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
  @@map("redemption_status_history")
}

