/// Web Push (PWA) subscription — one row per browser/device endpoint a user has
/// granted notification permission on. The push sender (push-sender.service.ts)
/// loads a user's subscriptions by `userId` (already tenant-bound) and posts
/// encrypted payloads to each `endpoint` via VAPID. UPSERT is keyed on `endpoint`
/// (the unique W3C Push endpoint URL); `userId`/`clientId` come from the JWT,
/// never the request body. Dead endpoints (404/410 on send) are pruned.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  clientId  String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([clientId])
  @@map("push_subscription")
}

/// Records that a user launched the app as an INSTALLED PWA (home-screen / standalone),
/// reported by a client beacon. One row per (user, platform); upserted, with lastSeenAt
/// refreshed on each standalone launch. Distinct from PushSubscription (notifications
/// enabled) — a user can install without subscribing, or vice-versa.
model PwaInstall {
  id          String   @id @default(cuid())
  userId      String
  clientId    String
  platform    String   // ANDROID | IOS | DESKTOP | OTHER
  userAgent   String?
  installedAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@index([clientId])
  @@index([userId])
  @@map("pwa_install")
}

/// One row per (user, IST-calendar-day) on which the user made >=1 authenticated
/// request. Written fire-and-forget from JwtStrategy.validate with an in-memory
/// once-per-day dedupe (~1 insert per active user per IST day per instance; the
/// unique (userId, activityDate) makes cross-instance repeats no-ops). This is the
/// activity signal behind the Session Report's active-days metric — DISTINCT from a
/// login: a 7-day access token means one login spans many active days. `activityDate`
/// is a DATE in Asia/Kolkata, so grouping by its year-month yields IST months directly.
/// No backfill — counting begins the day this ships (greenfield).
model UserActivityDay {
  id           String   @id @default(cuid())
  userId       String
  clientId     String   // active-context clientId from the JWT (tenant index; report scopes by User.clientId)
  activityDate DateTime @db.Date // IST calendar day (no time component)
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, activityDate])
  @@index([clientId, activityDate])
  @@index([activityDate])
  @@map("user_activity_day")
}

