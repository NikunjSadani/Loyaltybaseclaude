/// Employee Rewards Phase 0 — selects the earner model + capability set for a client.
/// TRADE_LOYALTY   = outlet earner (ChannelPartner; KYC/GST/TDS/payouts ON) — every client today.
/// EMPLOYEE_REWARDS = employee earner (SalesUser; the compliance stack OFF).
/// Code reads the resolved capability set (features), never this value directly, except to
/// select the earner model. Additive + default TRADE_LOYALTY → existing clients unchanged.
enum LoyaltyType {
  TRADE_LOYALTY
  EMPLOYEE_REWARDS
}

// ============================================================
// MODULE 1: USERS & AUTH
// ============================================================

// ──────────────────────────────────────────────────────────
// Client (tenant) — the authoritative tenant registry.
//
// IMPORTANT: id holds the tenant SLUG (e.g. "deoleo"), NOT a cuid.
//   id = the tenant slug; matches clientId across all other models.
//
// Foreign-key relations from User/etc. → Client are deferred
// (task 1.3 introduces the table; FK constraints land in 1.4+).
//
// Secrets note: notifications.msg91AuthKey is intentionally
// excluded from this table; it stays in env / Secret Manager only.
// ──────────────────────────────────────────────────────────
model Client {
  // id = the tenant slug; matches clientId across all other models
  id           String       @id // e.g. "deoleo" — NOT a cuid
  internalName String
  status       ClientStatus
  loyaltyType  LoyaltyType   @default(TRADE_LOYALTY) // Employee Rewards Phase 0 — earner-model switch
  onboardedAt  DateTime

  // Nested config blocks stored as JSON for schema flexibility.
  // msg91AuthKey is deliberately omitted from `notifications` — see above.
  branding          Json
  features          Json
  approvalHierarchy Json
  notifications     Json // excludes msg91AuthKey
  invoicing         Json
  wallet            Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("clients")
}

// ──────────────────────────────────────────────────────────
// ClientDomain — DB-driven tenant domain → slug routing (§A-DOMAIN).
//
// Replaces the in-code CLIENT_REGISTRY.domains map. A domain maps to
// exactly ONE tenant platform-wide: the migration hand-adds a
// LOWER("domain") UNIQUE index (Prisma can't model an expression
// index). `clientId` is a bare slug (= Client.id), no FK — matches
// the clientId convention on every other model. isPrimary marks the
// tenant's canonical/display domain.
// ──────────────────────────────────────────────────────────
model ClientDomain {
  id        String   @id @default(cuid())
  clientId  String
  domain    String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@map("client_domains")
}

model User {
  id                String     @id @default(cuid())
  clientId          String
  phone             String
  email             String?
  passwordHash      String?
  name              String
  role              UserRole
  status            UserStatus @default(PENDING_VERIFICATION)
  avatarUrl         String?
  preferredLanguage String     @default("en")
  fcmToken          String?
  lastLoginAt       DateTime?
  loginCount        Int        @default(0)
  // "Log out everywhere" high-water mark. logoutAllSessions / forceLogoutAll stamp this to
  // `now` alongside revoking session rows; refreshToken refuses any predecessor session whose
  // createdAt precedes it AND revokes any successor minted during a concurrent logout-all, so a
  // sweep can never be out-raced by an in-flight refresh. Additive + nullable, no backfill.
  sessionsInvalidBefore DateTime?
  // RBAC Option-X: for a GIFSY_STAFF user, the assigned custom role whose permission set
  // is their effective access. Null for every other role (and a GIFSY_STAFF with null role
  // has NO permissions — fail-closed). SetNull if the role is deleted.
  gifsyRoleId       String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  deletedAt         DateTime?

  // Relations
  gifsyRole                  GifsyRole?          @relation(fields: [gifsyRoleId], references: [id], onDelete: SetNull)
  // RBAC Option-X (P5): tenants this GIFSY_STAFF may assume/operate in (empty = none, deny-by-default).
  gifsyTenantGrants          GifsyStaffTenantGrant[] @relation("GifsyStaffTenantGrants")
  sessions                   UserSession[]
  otpCodes                   OtpCode[]
  auditLogs                  AuditLog[]          @relation("AuditActor")
  affectedAuditLogs          AuditLog[]          @relation("AuditTarget")
  salesUser                  SalesUser?
  channelPartner             ChannelPartner?
  kycSubmissions             KycSubmission[]
  tickets                    Ticket[]            @relation("TicketCreator")
  assignedTickets            Ticket[]            @relation("TicketAssignee")
  ticketMessages             TicketMessage[]
  notificationQueue          NotificationQueue[]
  dataRequests               DataRequest[]
  consentRecords             ConsentRecord[]
  scheduledReports           ScheduledReport[]
  reportDeliveryLogs         ReportDeliveryLog[]
  // Wave-0 scheme data-collection audit back-relations (§11). The submitter of an enrollment
  // is now audit-only (nullable, SetNull); full history + broadcasts are also attributed.
  schemeEnrollmentsSubmitted SchemeEnrollment[]  @relation("SchemeEnrollmentSubmitter")
  schemeSubmissions          SchemeSubmission[]  @relation("SchemeSubmissionSubmitter")
  schemeBroadcasts           SchemeBroadcast[]   @relation("SchemeBroadcastSender")
  // Visibility (POSM) captures this Gifsy admin approved/rejected.
  visibilityCapturesApproved VisibilityCapture[] @relation("VisibilityCaptureApprover")
  loginLogs                  LoginLog[]
  pushSubscriptions          PushSubscription[]
  pwaInstalls                PwaInstall[]
  activityDays               UserActivityDay[]

  // NOTE: the old `@@unique([clientId, phone])` is REPLACED by a PARTIAL unique index
  // `users_clientId_phone_active_key` WHERE status = 'ACTIVE' — defined in the migration
  // 20260811120000_user_phone_active_partial, not here (Prisma can't express partial indexes).
  // Only an ACTIVE user reserves a (clientId, phone); a deactivated/suspended/pending row frees
  // it so another user in the same tenant can reuse the number. The @@index([phone]) below stays.
  @@unique([clientId, email]) // email scoped per client (nullable handled by Postgres partial index)
  @@index([clientId])
  @@index([phone])
  @@index([email])
  @@index([role])
  @@index([status])
  @@index([deletedAt])
  @@index([gifsyRoleId])
  @@map("users")
}

/// RBAC Option-X — a custom Gifsy operator role (self-service, DB-backed). Holds a curated
/// set of Permission keys (see api/src/common/rbac/permissions.ts). Assigned to GIFSY_STAFF
/// users via User.gifsyRoleId; the guard resolves a staff member's access from it per-request.
/// clientId is always 'gifsy' (operator-owned). `isSystem` marks the seeded Ops / Project
/// Manager roles (renamable/editable, delete blocked). Reserved permissions (money-execution /
/// tenancy / users:manage_roles) are enforced NOT-grantable on the backend unless the owner
/// explicitly overrides — see RBAC-OPTION-X-STAFF.md.
model GifsyRole {
  id          String   @id @default(cuid())
  clientId    String
  name        String
  description String?
  // Curated Permission keys (api/src/common/rbac/permissions.ts). Stored as Postgres
  // text[] — the resolver validates each key via isPermission() and ignores unknowns.
  permissions String[]
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // Soft delete: a role in use can be retired without breaking users.gifsyRoleId (FK
  // SetNull). The resolver treats deletedAt != null as an empty permission set (fail-closed).
  deletedAt   DateTime?

  users User[]

  @@unique([clientId, name])
  @@index([clientId])
  @@index([deletedAt])
  @@map("gifsy_roles")
}

/// RBAC Option-X (P5) — which tenants a GIFSY_STAFF operator may work in.
///
/// The TENANT axis of staff access, orthogonal to the FEATURE axis (GifsyRole.permissions).
/// A staff acts on a tenant ONLY by ASSUMING it, and may assume ONLY a tenant they hold a
/// grant row for (auth.service.assumeTenant enforces this). Un-assumed staff are NOT
/// platform-wide (see common/tenant-scope.ts) → deny-by-default: a staff with zero grants
/// can operate on nothing. `clientId` is a bare tenant slug (= Client.id), no FK to Client,
/// matching the clientId convention on every other model; the service validates it against a
/// live Client row on grant. FK to User is CASCADE so deleting a staff drops their grants.
/// Extension point: add a nullable `roleId` here later for per-tenant-per-feature roles, or
/// union team-derived grants inside GifsyTenantGrantService — neither changes call sites.
model GifsyStaffTenantGrant {
  id        String   @id @default(cuid())
  userId    String
  clientId  String
  grantedBy String? // the owner (user id) who granted it — audit only
  createdAt DateTime @default(now())

  user User @relation("GifsyStaffTenantGrants", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([userId])
  @@index([clientId])
  @@map("gifsy_staff_tenant_grants")
}

model UserSession {
  id           String    @id @default(cuid())
  userId       String
  clientId     String // tenant slug bound at login (1.8)
  token        String    @unique
  refreshToken String?   @unique
  deviceId     String?
  deviceName   String?
  ipAddress    String?
  userAgent    String?
  // Sliding 7-day idle window (SESSION_TTL_DAYS). Re-minted to now+7d on every valid
  // access (jwt.strategy guard, throttled to ~once/day) AND on every refresh
  // (auth.service.generateTokens), so an actively-used session never expires while an
  // idle one lapses after 7 days of inactivity.
  expiresAt    DateTime
  lastSeenAt   DateTime? // last activity timestamp (display / audit)
  revokedAt    DateTime?
  // Idempotent-rotation chain: on refresh, the newly-minted successor row stores the id
  // of the predecessor session it rotated from. Lets a slow second tab that replays a
  // just-revoked refresh token (within a grace window) be handed the live successor's
  // stored tokens instead of a 401 — so parallel tabs converge instead of logging each
  // other out. Nullable (login-minted rows have no predecessor); additive, no backfill.
  rotatedFromId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([clientId])
  @@index([token])
  @@index([expiresAt])
  @@index([rotatedFromId])
  @@map("user_sessions")
}

model OtpCode {
  id          String     @id @default(cuid())
  userId      String?
  phone       String
  code        String
  purpose     OtpPurpose
  expiresAt   DateTime
  verifiedAt  DateTime?
  attempts    Int        @default(0)
  maxAttempts Int        @default(3)
  ipAddress   String?
  // Scopes an OTP to a specific entity so a confirm can only consume the OTP issued for THAT entity.
  // Used by REDEMPTION_CONFIRM to bind the OTP to its RedemptionOrder id — a login can now hold
  // concurrent PENDING orders across outlets (login picker), so an order-scoped lookup prevents one
  // order's confirm consuming another order's OTP. Nullable: purposes that don't scope leave it null.
  referenceId String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phone])
  @@index([userId])
  @@index([purpose])
  @@index([expiresAt])
  @@index([referenceId])
  @@map("otp_codes")
}

model AuditLog {
  id           String      @id @default(cuid())
  actorId      String?
  targetUserId String?
  action       AuditAction
  entityType   String
  entityId     String
  oldValues    Json?
  newValues    Json?
  ipAddress    String?
  userAgent    String?
  metadata     Json?
  createdAt    DateTime    @default(now())

  actor      User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetUser User? @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([targetUserId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

