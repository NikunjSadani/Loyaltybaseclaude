  startDate          DateTime
  endDate            DateTime
  holdingPeriodDays  Int          @default(30)
  rewardType         RewardType
  budgetPaise        Int?
  spentPaise         Int          @default(0)
  termsAndConditions String?
  isStackable        Boolean      @default(false)
