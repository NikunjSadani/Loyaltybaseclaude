// MODULE 4: KYC
// ============================================================

model KycSubmission {
  id                  String    @id @default(cuid())
  userId              String
  partnerId           String?
  status              KycStatus @default(DRAFT)
  submittedAt         DateTime?
  reviewedAt          DateTime?
  approvedAt          DateTime?
  rejectionReason     String?
  reviewerNotes       String?
  pennydropRef        String?
  pennydropStatus     String?
  pennydropVerifiedAt DateTime?
  agreementRef        String?
  agreementSignedAt   DateTime?
  escalatedFrom       String? // SalesRole that was skipped due to resignation (e.g. 'SO')
  version             Int       @default(1)

  // Shop-board name vs address-proof name mismatch, declared by the submitting rep.
  // When true, the tenant's `kycAddressProofWaiver` feature waives the Address Proof
  // document upload (the box was ticked instead of attaching a proof) — this column is
  // the durable audit trail that a reviewer sees ("address proof waived — names differ").
  // Distinct from the review-dump's bank-holder-vs-owner `nameMismatch` (a computed value).
  addressNameMismatch Boolean @default(false)

  // PROPOSED owner identity/detail changes for a re-KYC, staged here and applied to the live
  // ChannelPartner ONLY at Gifsy APPROVAL (never at draft) — so an already-approved partner never
  // carries unverified payout/identity details. Set only on a re-KYC create (existing partner);
  // null for a brand-new-outlet draft (that draft creates the partner directly). Holds the full
  // normalized patch (businessName/ownerName/phone/gst/pan/bank/upi/paymentMode).
  proposedPartner Json?

  // ── Geo capture #1 — taken when the outlet board photo is shot ──────────────
  boardPhotoLat         Decimal?  @db.Decimal(10, 8)
  boardPhotoLng         Decimal?  @db.Decimal(11, 8)
  boardPhotoGeoAccuracy Decimal?  @db.Decimal(8, 2)
  boardPhotoGeoAt       DateTime?

  // ── Geo capture #2 — taken when the cancelled cheque is uploaded or UPI QR is scanned ──
  paymentLat         Decimal?  @db.Decimal(10, 8)
  paymentLng         Decimal?  @db.Decimal(11, 8)
  paymentGeoAccuracy Decimal?  @db.Decimal(8, 2)
  paymentGeoAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  partner           ChannelPartner?       @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  documents         KycDocument[]
  statusHistory     KycStatusHistory[]
  consentRecords    ConsentRecord[]
  verificationItems KycVerificationItem[]

  @@index([userId])
  @@index([partnerId])
  @@index([status])
  @@index([submittedAt])
  @@map("kyc_submissions")
}

model KycDocument {
  id              String            @id @default(cuid())
  kycSubmissionId String
  documentType    KycDocumentType
  fileUrl         String
  fileKey         String
  fileName        String?
  fileSizeBytes   Int?
  mimeType        String?
  status          KycDocumentStatus @default(PENDING)
  rejectionReason String?
  verifiedAt      DateTime?
  expiresAt       DateTime?
  metadata        Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  kycSubmission KycSubmission @relation(fields: [kycSubmissionId], references: [id], onDelete: Cascade)

  @@index([kycSubmissionId])
  @@index([documentType])
  @@index([status])
  @@map("kyc_documents")
}

model KycStatusHistory {
  id              String     @id @default(cuid())
  kycSubmissionId String
  fromStatus      KycStatus?
  toStatus        KycStatus
  changedByUserId String?
  notes           String?
  metadata        Json?
  createdAt       DateTime   @default(now())

  kycSubmission KycSubmission @relation(fields: [kycSubmissionId], references: [id], onDelete: Cascade)

  @@index([kycSubmissionId])
  @@index([createdAt])
  @@map("kyc_status_history")
}

/// Field-level KYC verification (Option A) — one row per (submission × 7 fields).
/// The 7-field Gifsy grid (Stage 2) that begins when the submission reaches
/// PENDING_GIFSY. The verification DECISION lives here; KycDocument stays the
/// uploaded-file record (referenced via evidence.kycDocumentId, not duplicated).
/// Tenant-scoped via kycSubmission → user → clientId (no direct clientId, matching
/// the other KYC models). See docs/plans/reconcile/P3-onboarding-kyc.md §4.
model KycVerificationItem {
  id              String           @id @default(cuid())
  kycSubmissionId String
  fieldKey        KycFieldKey
  decision        KycFieldDecision @default(PENDING)
  source          KycFieldSource?
  remark          String?
  verifiedById    String? // the Gifsy admin (uploader for EXCEL; actor for PORTAL)
  verifiedAt      DateTime?
  evidence        Json? // PAYMENT:{pennydropRef,nameMatch} · GST:{legalName,status} · doc:{kycDocumentId}
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  kycSubmission KycSubmission @relation(fields: [kycSubmissionId], references: [id], onDelete: Cascade)

  @@unique([kycSubmissionId, fieldKey]) // exactly one row per (submission × field)
  @@index([kycSubmissionId])
  @@index([decision])
  @@map("kyc_verification_items")
}

model ConsentRecord {
  id              String    @id @default(cuid())
  userId          String
  kycSubmissionId String?
  consentType     String
  consentText     String
  version         String
  ipAddress       String?
  deviceInfo      String?
  consentedAt     DateTime  @default(now())
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  kycSubmission KycSubmission? @relation(fields: [kycSubmissionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([kycSubmissionId])
  @@index([consentType])
  @@map("consent_records")
}

model DataRequest {
  id          String            @id @default(cuid())
  userId      String
  requestType DataRequestType
  status      DataRequestStatus @default(PENDING)
  notes       String?
  processedBy String?
  processedAt DateTime?
  responseUrl String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([requestType])
  @@map("data_requests")
}

