// ============================================================
// MODULE 1: USERS & AUTH
// ============================================================

// ──────────────────────────────────────────────────────────
// Client (tenant) — the authoritative tenant registry.
//
// IMPORTANT: id holds the tenant SLUG (e.g. "deoleo"), NOT a cuid.
//   id = the tenant slug; matches clientId across all other models.
//
// Foreign-key relations from User/etc. → Client are deferred
// (task 1.3 introduces the table; FK constraints land in 1.4+).
//
// Secrets note: notifications.msg91AuthKey is intentionally
// excluded from this table; it stays in env / Secret Manager only.
// ──────────────────────────────────────────────────────────
model Client {
  // id = the tenant slug; matches clientId across all other models
  id           String       @id // e.g. "deoleo" — NOT a cuid
  internalName String
  status       ClientStatus
  onboardedAt  DateTime

  // Nested config blocks stored as JSON for schema flexibility.
  // msg91AuthKey is deliberately omitted from `notifications` — see above.
  branding          Json
  features          Json
  approvalHierarchy Json
  notifications     Json // excludes msg91AuthKey
  invoicing         Json
  wallet            Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("clients")
}

// ──────────────────────────────────────────────────────────
// ClientDomain — DB-driven tenant domain → slug routing (§A-DOMAIN).
//
// Replaces the in-code CLIENT_REGISTRY.domains map. A domain maps to
// exactly ONE tenant platform-wide: the migration hand-adds a
// LOWER("domain") UNIQUE index (Prisma can't model an expression
// index). `clientId` is a bare slug (= Client.id), no FK — matches
// the clientId convention on every other model. isPrimary marks the
// tenant's canonical/display domain.
// ──────────────────────────────────────────────────────────
model ClientDomain {
  id        String   @id @default(cuid())
  clientId  String
  domain    String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@map("client_domains")
}

model User {
  id                String     @id @default(cuid())
  clientId          String
  phone             String
  email             String?
  passwordHash      String?
  name              String
  role              UserRole
  status            UserStatus @default(PENDING_VERIFICATION)
  avatarUrl         String?
  preferredLanguage String     @default("en")
  fcmToken          String?
  lastLoginAt       DateTime?
  loginCount        Int        @default(0)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  deletedAt         DateTime?

  // Relations
  sessions           UserSession[]
  otpCodes           OtpCode[]
  auditLogs          AuditLog[]          @relation("AuditActor")
  affectedAuditLogs  AuditLog[]          @relation("AuditTarget")
  salesUser          SalesUser?
  channelPartner     ChannelPartner?
  kycSubmissions     KycSubmission[]
  tickets            Ticket[]            @relation("TicketCreator")
  assignedTickets    Ticket[]            @relation("TicketAssignee")
  ticketMessages     TicketMessage[]
  notificationQueue  NotificationQueue[]
  dataRequests       DataRequest[]
  consentRecords     ConsentRecord[]
  scheduledReports   ScheduledReport[]
  reportDeliveryLogs ReportDeliveryLog[]
  schemeEnrollments  SchemeEnrollment[]
  loginLogs          LoginLog[]
  pushSubscriptions  PushSubscription[]
  pwaInstalls        PwaInstall[]
  activityDays       UserActivityDay[]

  @@unique([clientId, phone]) // same phone can exist across different clients
  @@unique([clientId, email]) // email scoped per client (nullable handled by Postgres partial index)
  @@index([clientId])
  @@index([phone])
  @@index([email])
  @@index([role])
  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model UserSession {
  id           String    @id @default(cuid())
  userId       String
  clientId     String // tenant slug bound at login (1.8)
  token        String    @unique
  refreshToken String?   @unique
  deviceId     String?
  deviceName   String?
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime // sliding idle marker: bumped to now+365d on every valid request
  lastSeenAt   DateTime? // last activity timestamp (display / audit)
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([clientId])
  @@index([token])
  @@index([expiresAt])
  @@map("user_sessions")
}

model OtpCode {
  id          String     @id @default(cuid())
  userId      String?
  phone       String
  code        String
  purpose     OtpPurpose
  expiresAt   DateTime
  verifiedAt  DateTime?
  attempts    Int        @default(0)
  maxAttempts Int        @default(3)
  ipAddress   String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phone])
  @@index([userId])
  @@index([purpose])
  @@index([expiresAt])
  @@map("otp_codes")
}

model AuditLog {
  id           String      @id @default(cuid())
  actorId      String?
  targetUserId String?
  action       AuditAction
  entityType   String
  entityId     String
  oldValues    Json?
  newValues    Json?
  ipAddress    String?
  userAgent    String?
  metadata     Json?
  createdAt    DateTime    @default(now())

  actor      User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetUser User? @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([targetUserId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// MODULE 2: HIERARCHY
// ============================================================

model SalesHierarchyLevel {
  id          String   @id @default(cuid())
  clientId    String
  code        String
  name        String
  level       Int
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  salesUsers SalesUser[]

  @@unique([clientId, code])
  @@unique([clientId, level])
  @@index([clientId])
  @@index([level])
  @@map("sales_hierarchy_levels")
}

model SalesUser {
  id               String    @id @default(cuid())
  clientId         String // tenant slug — employeeCode is unique per tenant (RF7)
  userId           String    @unique
  hierarchyLevelId String
  employeeCode     String
  reportingToId    String?
  region           String?
  zone             String?
  isActive         Boolean   @default(true)
  joinedAt         DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  hierarchyLevel SalesHierarchyLevel   @relation(fields: [hierarchyLevelId], references: [id])
  reportingTo    SalesUser?            @relation("SalesUserReporting", fields: [reportingToId], references: [id])
  subordinates   SalesUser[]           @relation("SalesUserReporting")
  assignments    SalesUserAssignment[]

  @@unique([clientId, employeeCode])
  @@index([clientId])
  @@index([userId])
  @@index([hierarchyLevelId])
  @@index([reportingToId])
  @@index([employeeCode])
  @@index([deletedAt])
  @@map("sales_users")
}

model SalesUserAssignment {
  id           String    @id @default(cuid())
  salesUserId  String
  partnerId    String?
  outletId     String?
  assignedAt   DateTime  @default(now())
  unassignedAt DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  salesUser SalesUser       @relation(fields: [salesUserId], references: [id], onDelete: Cascade)
  partner   ChannelPartner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  outlet    Outlet?         @relation(fields: [outletId], references: [id], onDelete: SetNull)

  @@index([salesUserId])
  @@index([partnerId])
  @@index([outletId])
  @@map("sales_user_assignments")
}

// ============================================================
// MODULE 3: CHANNEL PARTNERS
// ============================================================

model ChannelPartner {
  id                String    @id @default(cuid())
  clientId          String // denormalised for efficient tenant filtering
  userId            String    @unique
  partnerCode       String
  businessName      String
  ownerName         String
  phone             String
  email             String?
  gstNumber         String?
  panNumber         String?
  // ── Entity / GST registration type (set at KYC approval; feeds P6 invoicing/TDS) ──
  entityType          EntityType?
  gstRegistrationType GstRegistrationType?
  // ── Bank / payout details (set on KYC approval) ──────────────────────────────
  bankName          String?
  bankAccountNumber String?
  bankAccountHolder String?
  ifscCode          String?
  upiId             String?
  paymentMode       String? // 'bank' | 'upi'
  totalEarnedPoints Int       @default(0)
  referredBy        String?
  isActive          Boolean   @default(true)
  onboardedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  outlets               Outlet[]
  kycSubmissions        KycSubmission[]
  wallets               Wallet[]
  salesAssignments      SalesUserAssignment[]
  visibilitySubmissions VisibilitySubmission[]
  redemptionOrders      RedemptionOrder[]
  payoutTransactions    PayoutTransaction[]
  leaderboardEntries    LeaderboardEntry[]

  @@unique([clientId, partnerCode])
  @@unique([clientId, gstNumber])
  @@index([clientId])
  @@index([userId])
  @@index([partnerCode])
  @@index([gstNumber])
  @@index([isActive])
  @@index([deletedAt])
  @@map("channel_partners")
}

// ============================================================
// MODULE 4: KYC
// ============================================================

model KycSubmission {
  id                  String    @id @default(cuid())
  userId              String
  partnerId           String?
  status              KycStatus @default(DRAFT)
  submittedAt         DateTime?
  reviewedAt          DateTime?
  approvedAt          DateTime?
  rejectionReason     String?
  reviewerNotes       String?
  pennydropRef        String?
  pennydropStatus     String?
  pennydropVerifiedAt DateTime?
  agreementRef        String?
  agreementSignedAt   DateTime?
  escalatedFrom       String? // SalesRole that was skipped due to resignation (e.g. 'SO')
  version             Int       @default(1)

  // Shop-board name vs address-proof name mismatch, declared by the submitting rep.
  // When true, the tenant's `kycAddressProofWaiver` feature waives the Address Proof
  // document upload (the box was ticked instead of attaching a proof) — this column is
  // the durable audit trail that a reviewer sees ("address proof waived — names differ").
  // Distinct from the review-dump's bank-holder-vs-owner `nameMismatch` (a computed value).
  addressNameMismatch Boolean   @default(false)

  // ── Geo capture #1 — taken when the outlet board photo is shot ──────────────
  boardPhotoLat         Decimal?  @db.Decimal(10, 8)
  boardPhotoLng         Decimal?  @db.Decimal(11, 8)
  boardPhotoGeoAccuracy Decimal?  @db.Decimal(8, 2)
  boardPhotoGeoAt       DateTime?

  // ── Geo capture #2 — taken when the cancelled cheque is uploaded or UPI QR is scanned ──
  paymentLat         Decimal?  @db.Decimal(10, 8)
  paymentLng         Decimal?  @db.Decimal(11, 8)
  paymentGeoAccuracy Decimal?  @db.Decimal(8, 2)
  paymentGeoAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  partner        ChannelPartner?    @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  documents          KycDocument[]
  statusHistory      KycStatusHistory[]
  consentRecords     ConsentRecord[]
  verificationItems  KycVerificationItem[]

  @@index([userId])
  @@index([partnerId])
  @@index([status])
  @@index([submittedAt])
  @@map("kyc_submissions")
}

model KycDocument {
  id              String            @id @default(cuid())
  kycSubmissionId String
  documentType    KycDocumentType
  fileUrl         String
  fileKey         String
  fileName        String?
  fileSizeBytes   Int?
  mimeType        String?
  status          KycDocumentStatus @default(PENDING)
  rejectionReason String?
  verifiedAt      DateTime?
  expiresAt       DateTime?
  metadata        Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  kycSubmission KycSubmission @relation(fields: [kycSubmissionId], references: [id], onDelete: Cascade)

  @@index([kycSubmissionId])
  @@index([documentType])
  @@index([status])
  @@map("kyc_documents")
}

model KycStatusHistory {
  id              String     @id @default(cuid())
  kycSubmissionId String
  fromStatus      KycStatus?
  toStatus        KycStatus
  changedByUserId String?
  notes           String?
  metadata        Json?
  createdAt       DateTime   @default(now())

  kycSubmission KycSubmission @relation(fields: [kycSubmissionId], references: [id], onDelete: Cascade)

  @@index([kycSubmissionId])
  @@index([createdAt])
  @@map("kyc_status_history")
}

/// Field-level KYC verification (Option A) — one row per (submission × 7 fields).
/// The 7-field Gifsy grid (Stage 2) that begins when the submission reaches
/// PENDING_GIFSY. The verification DECISION lives here; KycDocument stays the
/// uploaded-file record (referenced via evidence.kycDocumentId, not duplicated).
/// Tenant-scoped via kycSubmission → user → clientId (no direct clientId, matching
/// the other KYC models). See docs/plans/reconcile/P3-onboarding-kyc.md §4.
model KycVerificationItem {
  id              String           @id @default(cuid())
  kycSubmissionId String
  fieldKey        KycFieldKey
  decision        KycFieldDecision @default(PENDING)
  source          KycFieldSource?
  remark          String?
  verifiedById    String? // the Gifsy admin (uploader for EXCEL; actor for PORTAL)
  verifiedAt      DateTime?
  evidence        Json? // PAYMENT:{pennydropRef,nameMatch} · GST:{legalName,status} · doc:{kycDocumentId}
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  kycSubmission KycSubmission @relation(fields: [kycSubmissionId], references: [id], onDelete: Cascade)

  @@unique([kycSubmissionId, fieldKey]) // exactly one row per (submission × field)
  @@index([kycSubmissionId])
  @@index([decision])
  @@map("kyc_verification_items")
}

model ConsentRecord {
  id              String    @id @default(cuid())
  userId          String
  kycSubmissionId String?
  consentType     String
  consentText     String
  version         String
  ipAddress       String?
  deviceInfo      String?
  consentedAt     DateTime  @default(now())
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  kycSubmission KycSubmission? @relation(fields: [kycSubmissionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([kycSubmissionId])
  @@index([consentType])
  @@map("consent_records")
}

model DataRequest {
  id          String            @id @default(cuid())
  userId      String
  requestType DataRequestType
  status      DataRequestStatus @default(PENDING)
  notes       String?
  processedBy String?
  processedAt DateTime?
  responseUrl String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([requestType])
  @@map("data_requests")
}

// ============================================================
// MODULE 5: OUTLET
// ============================================================

model OutletType {
  id          String   @id @default(cuid())
  code        String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  outlets       Outlet[]
  clientConfigs OutletTypeClientConfig[]

  @@map("outlet_types")
}

model OutletTypeClientConfig {
  id           String @id @default(cuid())
  clientId     String
  outletTypeId String

  isEnabled          Boolean @default(true)
  displayName        String?
  loyaltyEnabled     Boolean @default(true)
  schemesEnabled     Boolean @default(true)
  visibilityEnabled  Boolean @default(true)
  payoutsEnabled     Boolean @default(true)
  leaderboardEnabled Boolean @default(true)
  targetsEnabled     Boolean @default(true)
  kycRequired        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outletType OutletType @relation(fields: [outletTypeId], references: [id])

  @@unique([clientId, outletTypeId], name: "clientId_outletTypeId")
  @@index([clientId])
  @@map("outlet_type_client_configs")
}

model Outlet {
  id              String           @id @default(cuid())
  clientId        String // tenant slug — outlet carries its own tenant tag (may exist before its owner/partner)
  partnerId       String? // owner attached at KYC; outlet can be created (via upload) before its owner exists
  outletTypeId    String
  // ── Reference-only master-file columns (from the outlet upload) — used for report grouping/summary ──
  distributorCode String?
  distributorName String?
  beat            String?
  metro           String?
  zone            String?
  programName     String?
  programCategory String?
  outletCode      String
  name            String
  ownerName       String?
  phone           String?
  addressLine1    String? // captured at KYC, not in the outlet master file
  addressLine2    String?
  city            String
  district        String?
  state           String
  pincode         String? // captured at KYC, not in the outlet master file
  country         String           @default("IN")
  latitude        Decimal?         @db.Decimal(10, 8)
  longitude       Decimal?         @db.Decimal(11, 8)
